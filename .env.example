# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:3000,http://doctor.localhost:3001,http://admin.localhost:3002,http://clinic.localhost:3003,http://localhost:3004,http://localhost:3006,http://localhost:3007

# ── Database (MySQL) ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_platform
DB_USER=root
DB_PASSWORD=changeme

# ── JWT ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string-at-least-32-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Admin seed (id + password come from here, hashed at boot) ─
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@indianhealthsystem.com
ADMIN_PASSWORD=Str0ng!AdminPass

# ── Google OAuth (leave blank to disable Google sign-in) ─────
GOOGLE_CLIENT_ID=

# ── Nodemailer (SMTP) — leave SMTP_HOST blank for Ethereal dev inbox ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Indian Health System <no-reply@indianhealthsystem.com>

# ── Password reset ───────────────────────────────────────
RESET_TOKEN_TTL_MINUTES=45

# ── Forgot password by mobile OTP ────────────────────────
# SMS_PROVIDER: none (default — the OTP option reports "not configured"),
# mock (dev only: the SMS is printed to the API console), or twilio (also needs
# TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN; TWILIO_SMS_FROM is the sending number).
SMS_PROVIDER=none
TWILIO_SMS_FROM=
PASSWORD_OTP_TTL_MINUTES=10
PASSWORD_OTP_MAX_ATTEMPTS=5
PASSWORD_OTP_MAX_PER_HOUR=5
PASSWORD_OTP_RESEND_SECONDS=60

# ── Razorpay (online payments) ───────────────────────────
# Test-mode keys from the Razorpay dashboard. Blank in dev keeps online payments
# disabled (offline "pay at clinic" still works); required in production.
# Only RAZORPAY_KEY_ID is ever sent to the client. Set RAZORPAY_WEBHOOK_SECRET to
# the same value configured on the dashboard webhook (URL: /api/webhooks/razorpay,
# events: payment.captured + order.paid).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── LiveKit (video consultation) ──────────────────────────
# From your LiveKit Cloud project (https://cloud.livekit.io). LIVEKIT_URL is the
# public wss:// SFU URL — set the SAME value as NEXT_PUBLIC_LIVEKIT_URL on the
# frontends. The API key/secret are server-only (mint join tokens + verify
# webhooks) — NEVER expose the secret. Blank in dev disables video (everything
# else still works); required in production. Point the Cloud webhook at
# /api/webhooks/livekit.
#
# Local-only alternative (no cloud account): run the open-source server with
# `livekit-server --dev --bind 127.0.0.1` (github.com/livekit/livekit releases)
# and use LIVEKIT_URL=ws://127.0.0.1:7880, LIVEKIT_API_KEY=devkey,
# LIVEKIT_API_SECRET=secret. Those are LiveKit's public dev-mode keys — never
# use them on a server reachable from the internet.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Rate limiting ────────────────────────────────────────
# Proxy hops in front of the app. 1 = a single nginx/ALB. Raise for
# Cloudflare→nginx (2) etc. Too LOW and every user shares one bucket.
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MIN=15
# Blanket per-IP API cap. A DoS backstop, not a usage quota — 100 (~7/min) was
# far too tight for a dashboard, and a clinic behind one NAT shares it.
RATE_LIMIT_MAX=600
# Signed-in READS per user per window (separate from the above, which now caps anonymous traffic + writes)
READ_RATE_LIMIT_MAX=3000
# Print every SQL statement in development (off by default; slow queries always print)
DB_SQL_LOG=false
# FAILED credential attempts only; successful logins never count.
AUTH_RATE_LIMIT_MAX=10
# Token refreshes — machine-driven, and SEPARATE from AUTH on purpose.
REFRESH_RATE_LIMIT_MAX=120

# ── File storage (doctor documents & photos) ─────────────
# `local` writes to ./uploads (zero cloud setup). `cloudinary` (recommended for
# prod — CLOUDINARY_SETUP.md) or `s3` need their credentials below (env
# validation fails fast otherwise). Files stored under an earlier driver keep working.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:5000
MAX_UPLOAD_MB=10

# S3 — required only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary — required only when STORAGE_DRIVER=cloudinary (see CLOUDINARY_SETUP.md).
# BACKEND ONLY: never copy these into any frontend-* or mobile-* env file. Clients
# never need them — the API signs everything and returns finished URLs.
# Values: Cloudinary Console → Settings → API Keys. With STORAGE_DRIVER=cloudinary,
# PUBLIC_URL above MUST be the API's public origin (private file links use it).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for every IHS asset — use a different one per environment (ihs-dev, ihs-staging, ihs).
CLOUDINARY_FOLDER=ihs
# Delivery optimisation for PUBLIC images only. Blank disables (e.g. strict transformations on).
CLOUDINARY_PUBLIC_IMAGE_TRANSFORMATION=c_limit,w_1600,f_auto,q_auto
CLOUDINARY_TIMEOUT_MS=60000

# Private file links (all drivers): /api/files/<signed token>/<name> links in API
# responses stay valid between TTL and 2×TTL minutes.
FILE_URL_TTL_MINUTES=60
